<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>MxClickHaptics.LogitechPlugin</AssemblyName>
    <RootNamespace>Loupedeck.MxClickHapticsPlugin</RootNamespace>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <PluginApiDir>C:\Program Files\Logi\LogiPluginService\</PluginApiDir>
    <PluginOutputRoot>$(MSBuildProjectDirectory)\artifacts\$(Configuration)\</PluginOutputRoot>
    <OutputPath>$(PluginOutputRoot)bin\</OutputPath>
    <PluginDir>$(LocalAppData)\Logi\LogiPluginService\Plugins\</PluginDir>
    <MarketplacePackagePath>$(MSBuildProjectDirectory)\artifacts\Marketplace\MxClickHaptics_1_1.lplug4</MarketplacePackagePath>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="PluginApi">
      <HintPath>$(PluginApiDir)PluginApi.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <ProjectReference Include="..\MxClickHaptics.Core\MxClickHaptics.Core.csproj" />
  </ItemGroup>

  <Target Name="ValidatePluginApi" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(PluginApiDir)PluginApi.dll')"
           Text="Logi Plugin Service SDK not found at $(PluginApiDir)PluginApi.dll." />
  </Target>

  <Target Name="CopyPackage" AfterTargets="Build">
    <ItemGroup>
      <PackageFiles Include="package\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(PackageFiles)"
          DestinationFolder="$(PluginOutputRoot)%(RecursiveDir)" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\..\LICENSE"
          DestinationFiles="$(PluginOutputRoot)EULA.txt" />
  </Target>

  <Target Name="RegisterPlugin" AfterTargets="CopyPackage" Condition="'$(Configuration)' == 'Debug'">
    <MakeDir Directories="$(PluginDir)" />
    <WriteLinesToFile File="$(PluginDir)$(AssemblyName).link"
                      Lines="$(PluginOutputRoot)"
                      Overwrite="true"
                      Encoding="UTF-8" />
    <Message Text="Logitech plugin linked from $(PluginOutputRoot)" Importance="High" />
  </Target>

  <Target Name="PackMarketplace" DependsOnTargets="Build">
    <MakeDir Directories="$([System.IO.Path]::GetDirectoryName('$(MarketplacePackagePath)'))" />
    <Exec Command="logiplugintool pack &quot;$(PluginOutputRoot)&quot; &quot;$(MarketplacePackagePath)&quot;" />
    <Exec Command="logiplugintool verify &quot;$(MarketplacePackagePath)&quot;" />
    <Message Text="Verified Marketplace package: $(MarketplacePackagePath)" Importance="High" />
  </Target>
</Project>
